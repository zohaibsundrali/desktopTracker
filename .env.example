# ------------------------------------------------------------
# Developer Tracker — environment template
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env        (Windows: copy .env.example .env)
#
# `.env` is git-ignored — never commit it.
# ------------------------------------------------------------

# Supabase project URL
# Found in: Supabase Dashboard > Project Settings > API > Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase API key
#
# ⚠️  Use the ANON (public) key here — NOT the service_role key.
#     This app runs on end-user machines, so anyone who installs it can
#     read this value. A service_role key bypasses Row Level Security and
#     would give any user full admin access to the whole database.
#     Protect data with RLS policies instead.
#
# Found in: Supabase Dashboard > Project Settings > API > Project API keys > anon / public
SUPABASE_KEY=your-anon-public-key

# ------------------------------------------------------------
# Optional settings
# ------------------------------------------------------------

# Toggle automatic background screenshots.
# Defaults to true if not set. Set to false to disable without code changes.
SCREENSHOTS_ENABLED=true
